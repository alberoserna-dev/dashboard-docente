---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import CicloHexagono from '../components/CicloHexagono.astro';
import ciclosData from '../data/ciclos.js'; // Importamos datos de ciclos
---
<Layout>
	<section class="hero">
	<h1>Mis <span class="text-pastel">Recursos</span></h1>
	<p>Acceso directo a mis materiales por ciclo formativo</p>
	</section>

	<div class="panal-container">
	{ciclosData.map((ciclo) => (
		<CicloHexagono 
		titulo={ciclo.titulo}
		icono={ciclo.icono}
		color={ciclo.color}
		url={ciclo.url}
		/>
	))}
	</div>
</Layout>

<style>

  .main-container {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .hero {
    margin-bottom: 4rem;
	text-align: center;
  }

  .hero h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
	font-weight: 800;
  }

  .text-pastel {
    color: var(--color-amarillo-pastel);
  }

  .panal-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px; /* Reducimos el hueco general */
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  :global(.hexagon-wrapper) {
    margin: -15px 5px; 
  }

  /* Media query para móviles */
  @media (max-width: 600px) {
    .header h1 { font-size: 2.5rem; }
  }
</style>