---
// src/pages/modulo/[id]/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const modulos = ['pare', 'sad', 'ede', 'ada'];
  const paths: Array<{ params: { id: string; slug: string } }> = [];

  const todosLosTemas: any[] = await getCollection('material-docente');

  for (const modulo of modulos) {
    const temasDelModulo = todosLosTemas.filter(tema => {
      const rutaNormalizada = tema.id.replace(/\\/g, '/').toLowerCase();
      return rutaNormalizada.startsWith(`${modulo.toLowerCase()}/`);
    });
    
    temasDelModulo.forEach(tema => {
      const slugGenerado = tema.slug || tema.id.replace(/\\/g, '/').split('/').pop()?.replace(/\.md$/, '');
      paths.push({ params: { id: modulo, slug: slugGenerado } });
    });
  }
  return paths;
}

const { id, slug } = Astro.params;
const todosLosTemas = await getCollection('material-docente');

const entry = todosLosTemas.find(tema => {
  const perteneceAlModulo = tema.id.replace(/\\/g, '/').toLowerCase().startsWith(`${id?.toLowerCase()}/`);
  const entrySlug = tema.slug || tema.id.replace(/\\/g, '/').split('/').pop()?.replace(/\.md$/, '');
  
  return perteneceAlModulo && entrySlug === slug;
});

if (!entry) {
  return Astro.redirect(`${import.meta.env.BASE_URL}/404`);
}

const { Content, headings } = await render(entry);
---

<Layout>
  <div class="doc-container">
    <!-- Menú lateral izquierdo: Índice dinámico de las notas de Obsidian -->
    <aside class="sidebar">
      <div class="sidebar-sticky">
        <a href="javascript:history.back()" class="back-button">
          <i class="bi bi-arrow-left"></i> Volver
        </a>
        <h3>En este tema</h3>
        <ul>
          {headings.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <!-- Contenido principal de los apuntes -->
    <article class="markdown-body">
      <header class="content-header">
        <span class="module-tag">{id.toUpperCase()}</span>
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="desc">{entry.data.description}</p>}
      </header>
      
      <div class="content-render">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const blockquotes = document.querySelectorAll('.content-render blockquote');
    
    blockquotes.forEach(bq => {
      const firstP = bq.querySelector('p');
      if (!firstP) return;

      // Busco la etiqueta [!NOTE]
      const regex = /^\[!note\](.*?)(\n|<br>|$)/i;
      const match = firstP.innerHTML.match(regex);
      
      if (match) {
        // Añado las clases básicas para notas
        bq.classList.add('obsidian-callout', 'callout-note');
        
        firstP.innerHTML = firstP.innerHTML.replace(regex, (completo, titulo) => {
          let titleText = titulo.trim();
          if (!titleText) titleText = "Nota"; // Título por defecto si está vacío
          
          return `<div class="callout-header"><i class="bi bi-pencil-fill"></i> <span>${titleText}</span></div>`;
        });
      }
    });
  });
</script>

<style>
  .doc-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    padding: 2rem 0;
    max-width: 1200px;
    margin: 0 auto;
    text-align: left;
  }

  /* Estilos del Menú Lateral */
  .sidebar {
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    padding-right: 2rem;
  }

  .sidebar-sticky {
    position: sticky;
    top: 2rem;
  }

  .back-button {
    display: inline-block;
    color: var(--color-rojo-pastel);
    text-decoration: none;
    margin-bottom: 2rem;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .sidebar h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-amarillo-pastel);
    margin-bottom: 1rem;
  }

  .sidebar ul { list-style: none; padding: 0; }
  .sidebar li { margin-bottom: 0.8rem; }
  .sidebar a {
    color: #8b949e;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .sidebar a:hover { color: #fff; }
  
  .depth-3 { margin-left: 1.2rem; font-size: 0.85rem; }

  /* Estilos del contenido Markdown */
  .markdown-body {
    max-width: 800px;
  }

  .content-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1.5rem;
  }

  .module-tag {
    font-family: monospace;
    color: var(--color-naranja-pastel);
    font-weight: bold;
  }

  .content-header h1 {
    font-size: 2.8rem;
    margin: 0.5rem 0;
    line-height: 1.2;
  }

  .desc {
    color: #8b949e;
    font-size: 1.1rem;
  }

  /* Ajustes para el renderizado de Obsidian */
  .content-render :global(h2) {
    color: var(--color-amarillo-pastel);
    margin-top: 3rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .content-render :global(p) {
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: #d1d5db;
  }

  /* --- ESTILOS DE LOS CALLOUTS DE OBSIDIAN --- */
  .content-render :global(blockquote) {
    /* Estilo para citas normales de Markdown */
    border-left: 4px solid var(--color-rojo-pastel);
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.5rem;
    margin: 2rem 0;
  }

  .content-render :global(blockquote.obsidian-callout) {
    border-left-width: 4px;
    border-left-style: solid;
    padding: 0 1.5rem 1rem 1.5rem;
    margin: 2rem 0;
    border-radius: 0 8px 8px 0;
  }

  .content-render :global(.callout-header) {
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  /* Estilo exclusivo para el bloque de Nota (Azul) */
  .content-render :global(blockquote.callout-note) { 
    border-left-color: #3b82f6; 
    background: rgba(59, 130, 246, 0.1); 
  }
  .content-render :global(blockquote.callout-note .callout-header) { 
    color: #3b82f6; 
  }

  @media (max-width: 900px) {
    .doc-container { grid-template-columns: 1fr; }
    .sidebar { display: none; }
  }
</style>