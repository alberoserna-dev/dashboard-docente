---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Mis Recursos Docentes</title>
	</head>
	<body>
		<div class="app-wrapper">
			<Header />
			<main class="main-content">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--color-negro: #1a1a1a;
		--color-rojo-pastel: #ff6b6b;
		--color-naranja-pastel: #ff9248;
		--color-amarillo-pastel: #ffcc5c;
		--color-crema: #ffeaa7;
		
		--bg-fondo: #0f1115;
		--text-principal: #f8f9fa;
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-fondo);
		color: var(--text-principal);
		font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
	}

	.app-wrapper {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Estilo base para el contenedor principal */
	.main-container {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		/* justify-content: center; */
		padding: 2rem 0;
		min-height: 100vh;
		overflow-y: auto;
	}
	
	/* CALLOUTS */
	/* 1. Contenedor principal de la nota */
	div[data-callout] {
		margin: 2rem 0;
		padding: 1.2rem 1.5rem;
		border-radius: 8px;
		border-left: 6px solid #448aff; /* Color Note por defecto */
		background: rgba(68, 138, 255, 0.1);
		display: block;
		text-align: left;
	}

	/* 2. El título de la nota (donde pone "Nota") */
	.callout-title {
		font-weight: bold;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: 0.8rem;
		display: block;
		font-size: 0.9rem;
		letter-spacing: 1px;
	}

	/* 3. El cuerpo del mensaje */
	.callout-body {
		color: #d1d5db;
		line-height: 1.6;
	}

	/* Si el tipo es "note" (Azul) */
	div[data-callout-type="note"] {
		border-left-color: #448aff;
		background: rgba(68, 138, 255, 0.08);
	}

	/* Si el tipo es "warning" (Naranja) */
	div[data-callout-type="warning"] {
		border-left-color: var(--color-naranja-pastel);
		background: rgba(255, 146, 72, 0.1);
	}

  /* Si el tipo es "tip" o "hint" (Amarillo) */
	div[data-callout-type="tip"], 
	div[data-callout-type="hint"] {
		border-left-color: var(--color-amarillo-pastel);
		background: rgba(255, 204, 92, 0.1);
	}

	/* Si el tipo es "important" o "danger" (Rojo) */
	div[data-callout-type="important"],
	div[data-callout-type="danger"] {
		border-left-color: var(--color-rojo-pastel);
		background: rgba(255, 107, 107, 0.1);
	}
</style>