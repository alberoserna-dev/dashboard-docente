---
// src/components/CicloHexagono.astro
interface Props {
  titulo: string;
  icono: string;
  color: string;
  url: string;
}

const { titulo, icono, color, url } = Astro.props;
const finalUrl = url.startsWith('/') ? `${import.meta.env.BASE_URL}${url}` : url;
---
<a href={finalUrl} class="hexagon-wrapper">
  <div class="hexagon" style={`background-color: ${color};`}>
    <div class="hexagon-content">
      <i class={icono}></i>
      <span>{titulo}</span>
    </div>
  </div>
</a>

<style>
  .hexagon-wrapper {
    text-decoration: none;
    display: block;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .hexagon {
    width: 200px;
    height: 220px;
    background-color: var(--hex-color);
    /* Fórmula matemática del hexágono */
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    /* Efecto de suavizado para el color */
    filter: brightness(0.9);
    transition: filter 0.3s ease, transform 0.3s ease;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.1);
  }

  .hexagon-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #1a1a1a; /* Texto oscuro para contrastar con el pastel */
    font-weight: bold;
    text-align: center;
    padding: 10px;
  }

  .hexagon-content i {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  .hexagon-content span {
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Interactividad */
  .hexagon-wrapper:hover {
    transform: scale(1.1);
    z-index: 10;
  }
</style>